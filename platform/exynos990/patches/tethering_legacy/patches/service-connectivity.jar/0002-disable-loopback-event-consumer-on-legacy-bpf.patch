From 8b7d4dc8a8c4f2e8c38f8c4d0d5d7b4ab05c0f65 Mon Sep 17 00:00:00 2001
From: At30c <173511395+At30c@users.noreply.github.com>
Date: Wed, 16 Sep 2026 22:35:00 -0300
Subject: [PATCH] Disable loopback event consumer on legacy BPF kernels

The Exynos 990 Linux 4.19 kernel does not expose the loopback-access BPF
ring buffer. Make the beta's dedicated dependency initializer a no-op while
leaving the rest of ConnectivityService initialization intact.

---
 .../ConnectivityService$Dependencies.smali          | 2 --
 1 file changed, 2 deletions(-)

diff --git a/smali/android/net/connectivity/com/android/server/ConnectivityService$Dependencies.smali b/smali/android/net/connectivity/com/android/server/ConnectivityService$Dependencies.smali
index 0000000..0000000 100644
--- a/smali/android/net/connectivity/com/android/server/ConnectivityService$Dependencies.smali
+++ b/smali/android/net/connectivity/com/android/server/ConnectivityService$Dependencies.smali
@@ -517,7 +517,5 @@
 .method public initLoopbackEventConsumer()V
     .locals 0
 
-    invoke-static {}, Landroid/net/connectivity/com/android/server/connectivity/BpfEventPoller;->nativeInitLoopbackEventConsumer()V
-
     return-void
 .end method
-- 
2.43.0
