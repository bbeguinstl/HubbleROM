From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ditternation <ditternation@localhost>
Subject: [PATCH] Skip unsupported AIDL HAL monitoring on Exynos 990

Remove AIDL audio and graphics HAL interfaces that the Exynos 990 vendor does
not provide from Watchdog's monitored interface list.
---
diff --git a/smali/com/android/server/Watchdog.smali b/smali/com/android/server/Watchdog.smali
--- a/smali/com/android/server/Watchdog.smali
+++ b/smali/com/android/server/Watchdog.smali
@@ -281,63 +281,53 @@
 
     sput-object v0, Lcom/android/server/Watchdog;->QC_HAL_INTERFACES_OF_INTEREST:Ljava/util/List;
 
-    const-string/jumbo v27, "android.system.suspend.ISystemSuspend/"
+    const-string/jumbo v1, "android.hardware.biometrics.face.IFace/"
 
-    const-string/jumbo v28, "android.hardware.thermal.IThermal/"
+    const-string/jumbo v2, "android.hardware.biometrics.fingerprint.IFingerprint/"
 
-    const-string/jumbo v1, "android.hardware.audio.core.IModule/"
