-    const-string/jumbo v2, "android.hardware.audio.core.IConfig/"
+    const-string/jumbo v4, "android.hardware.camera.provider.ICameraProvider/"
 
-    const-string/jumbo v3, "android.hardware.audio.effect.IFactory/"
+    const-string/jumbo v5, "android.hardware.contexthub.IContextHub/"
 
-    const-string/jumbo v4, "android.hardware.biometrics.face.IFace/"
