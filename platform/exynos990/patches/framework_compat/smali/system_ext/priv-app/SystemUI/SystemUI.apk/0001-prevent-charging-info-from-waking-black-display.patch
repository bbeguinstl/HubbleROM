From 9e2f0b48a0c0f7a4b0f1b34e48c0e3a7b9a8d2c1 Mon Sep 17 00:00:00 2001
From: At30c <173511395+At30c@users.noreply.github.com>
Date: Wed, 23 Sep 2026 01:20:00 -0300
Subject: [PATCH] SystemUI: do not wake display for charging info overlays

On the S24+ port, ChargingInfoExecutor calls PowerManager.wakeUp() when
showing incomplete/slow-charger UI. On the legacy display stack this can
leave the panel powered with no visible frame. Keep the charging popup/toast,
but do not force a display wake from these informational overlays.

diff --git a/smali_classes3/com/android/systemui/power/feature/charginginfo/ChargingInfoExecutor.smali b/smali_classes3/com/android/systemui/power/feature/charginginfo/ChargingInfoExecutor.smali
--- a/smali_classes3/com/android/systemui/power/feature/charginginfo/ChargingInfoExecutor.smali
+++ b/smali_classes3/com/android/systemui/power/feature/charginginfo/ChargingInfoExecutor.smali
@@ -56,7 +56,7 @@
 
     move-result-wide v1
 
-    invoke-virtual {p0, v1, v2, v0}, Landroid/os/PowerManager;->wakeUp(JLjava/lang/String;)V
+    nop
     :try_end_0
     .catch Ljava/lang/Exception; {:try_start_0 .. :try_end_0} :catch_0
 
-- 
2.43.0
