Subject: [PATCH] Allow KeyMint spoofing for custom keybox

diff --git a/smali_classes4/android/security/keystore2/KeymasterUtils.smali b/smali_classes4/android/security/keystore2/KeymasterUtils.smali
--- a/smali_classes4/android/security/keystore2/KeymasterUtils.smali
+++ b/smali_classes4/android/security/keystore2/KeymasterUtils.smali
@@ -428,8 +428,23 @@
 .end method
 
 .method public static blacklist isKeyMintDevice(I)Z
-    .locals 4
-
+    .locals 5
+
+    const-string v4, "persist.sys.unica.keybox"
+
+    const/4 v1, 0x0
+
+    invoke-static {v4, v1}, Landroid/os/SemSystemProperties;->getBoolean(Ljava/lang/String;Z)Z
+
+    move-result v4
+
+    if-eqz v4, :cond_8
+
+    const/4 v0, 0x1
+
+    return v0
+
+    :cond_8
     const/16 v0, 0x64
 
     const/4 v1, 0x0
