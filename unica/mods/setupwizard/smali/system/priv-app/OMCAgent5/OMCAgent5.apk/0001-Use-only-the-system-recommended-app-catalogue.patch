Subject: [PATCH] OMCAgent: use the system recommended-app catalogue on Android 17

diff --git a/smali/a8/d.smali b/smali/a8/d.smali
--- a/smali/a8/d.smali
+++ b/smali/a8/d.smali
@@ -74,6 +74,14 @@
 
     move-result-object v0
 
+    const-string v1, "/system/etc/omcagent"
+
+    const-string v2, "unica_appres.json"
+
+    invoke-static {v1, v2}, La8/d;->d(Ljava/lang/String;Ljava/lang/String;)Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;
+
+    move-result-object v0
+
     sget-object v1, Ljava/util/Locale;->US:Ljava/util/Locale;
 
     sget-object v1, Lcom/samsung/android/app/omcagent/rna/code/ConfigType;->ab:Lcom/samsung/android/app/omcagent/rna/code/ConfigType;
@@ -101,6 +109,8 @@
     invoke-static {v3, v2}, La8/d;->d(Ljava/lang/String;Ljava/lang/String;)Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;
 
     move-result-object v2
+
+    const/4 v2, 0x0
 
     invoke-static {v0, v2}, La8/d;->m(Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;)Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;
 
@@ -492,11 +502,15 @@
 
     move-result-object v3
 
+    const/4 v3, 0x0
+
     const-string v4, "/omr/carrier"
 
     invoke-static {v4, v0, p2}, La8/d;->i(Ljava/lang/String;Ljava/lang/String;Z)Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;
 
     move-result-object v4
+
+    const/4 v4, 0x0
 
     invoke-static {v3, v2}, La8/d;->m(Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;)Lcom/samsung/android/app/omcagent/rna/model/AppResInfo;
 
