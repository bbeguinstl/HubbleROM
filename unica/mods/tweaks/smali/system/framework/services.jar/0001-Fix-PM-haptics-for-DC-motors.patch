Subject: [PATCH] Fix PM haptics for DC motors on Android 17

diff --git a/smali_classes2/com/android/server/vibrator/HapticFeedbackVibrationProvider.smali b/smali_classes2/com/android/server/vibrator/HapticFeedbackVibrationProvider.smali
--- a/smali_classes2/com/android/server/vibrator/HapticFeedbackVibrationProvider.smali
+++ b/smali_classes2/com/android/server/vibrator/HapticFeedbackVibrationProvider.smali
@@ -257,6 +257,10 @@
     :cond_0
     if-eqz p0, :cond_2
 
+    const/16 v0, 0x2713
+
+    if-eq p0, v0, :cond_1
+
     const v0, 0xc3d4
 
     if-ne p0, v0, :cond_1
