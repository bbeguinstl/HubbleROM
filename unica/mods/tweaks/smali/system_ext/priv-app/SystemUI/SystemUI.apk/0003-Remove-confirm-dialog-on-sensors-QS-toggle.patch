Subject: [PATCH] Remove sensor privacy confirmation on Android 17

diff --git a/smali_classes3/com/android/systemui/qs/tiles/SensorPrivacyToggleTile.smali b/smali_classes3/com/android/systemui/qs/tiles/SensorPrivacyToggleTile.smali
--- a/smali_classes3/com/android/systemui/qs/tiles/SensorPrivacyToggleTile.smali
+++ b/smali_classes3/com/android/systemui/qs/tiles/SensorPrivacyToggleTile.smali
@@ -290,6 +290,8 @@
 .method public final toggleTileState()V
     .locals 5
 
+    goto :unica_toggle_sensor
+
     invoke-virtual {p0}, Lcom/android/systemui/qs/tiles/SensorPrivacyToggleTile;->getSensorId()I
 
     move-result v0
@@ -430,4 +432,25 @@
 
     :cond_3
     return-void
-.end method
+
+    :unica_toggle_sensor
+    iget-object v0, p0, Lcom/android/systemui/qs/tiles/SensorPrivacyToggleTile;->mSensorPrivacyController:Lcom/android/systemui/statusbar/policy/IndividualSensorPrivacyController;
+
+    check-cast v0, Lcom/android/systemui/statusbar/policy/IndividualSensorPrivacyControllerImpl;
+
+    const/4 v1, 0x1
+
+    invoke-virtual {p0}, Lcom/android/systemui/qs/tiles/SensorPrivacyToggleTile;->getSensorId()I
+
+    move-result v2
+
+    invoke-virtual {v0, v2}, Lcom/android/systemui/statusbar/policy/IndividualSensorPrivacyControllerImpl;->isSensorBlocked(I)Z
+
+    move-result v3
+
+    xor-int/2addr v3, v1
+
+    invoke-virtual {v0, v1, v2, v3}, Lcom/android/systemui/statusbar/policy/IndividualSensorPrivacyControllerImpl;->setSensorBlocked(IIZ)V
+
+    return-void
+.end method
