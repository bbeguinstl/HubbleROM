Subject: [PATCH] Enable network-speed preference on Android 17 beta

diff --git a/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali b/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
--- a/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
+++ b/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
@@ -514,9 +514,9 @@
     const/4 v3, 0x0
 
     invoke-virtual {v0, v2, v3}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
 
-    move-result v0
+    const/4 v0, 0x1
 
     if-eqz v0, :cond_1f
 
     const-string/jumbo v0, "network_speed"
@@ -2163,9 +2163,9 @@
     const/4 v3, 0x0
 
     invoke-virtual {v0, v2, v3}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
 
-    move-result v0
+    const/4 v0, 0x1
 
     if-eqz v0, :cond_4
 
     const-string/jumbo v0, "network_speed"
diff --git a/smali_classes4/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali b/smali_classes4/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
--- a/smali_classes4/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
+++ b/smali_classes4/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
@@ -33,9 +33,9 @@
     const/4 v2, 0x0
 
     invoke-virtual {v0, v1, v2}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
 
-    move-result v0
+    const/4 v0, 0x1
 
     sput-boolean v0, Lcom/samsung/android/settings/notification/StatusBarNetworkSpeedController;->SUPPORT_NETWORK_SPEED:Z
 
     new-instance v0, Lcom/samsung/android/settings/notification/StatusBarNetworkSpeedController$1;
diff --git a/smali_classes4/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$3.smali b/smali_classes4/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$3.smali
--- a/smali_classes4/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$3.smali
+++ b/smali_classes4/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$3.smali
@@ -46,9 +46,9 @@
     const/4 v2, 0x0
 
     invoke-virtual {v0, v1, v2}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
 
-    move-result v0
+    const/4 v0, 0x1
 
     if-nez v0, :cond_2
 
     const-string/jumbo v0, "network_speed"
