Subject: [PATCH 16/20] Resume ROM updater jobs without DM Exec on Android 17 beta

diff --git a/smali/com/idm/fotaagent/scheduler/intentresume/IDMIntentBootResume.smali b/smali/com/idm/fotaagent/scheduler/intentresume/IDMIntentBootResume.smali
--- a/smali/com/idm/fotaagent/scheduler/intentresume/IDMIntentBootResume.smali
+++ b/smali/com/idm/fotaagent/scheduler/intentresume/IDMIntentBootResume.smali
@@ -214,9 +214,10 @@
     invoke-virtual {p0, p1}, Lcom/idm/fotaagent/database/sqlite/database/IDMDatabaseManager;->getExecInfo(Ljava/lang/String;)Lcom/idm/agent/dm/IDMDmExecInfo;
 
     move-result-object p0
 
-    if-nez p0, :cond_4
+    # UN1CA: resume ROM jobs even when there is no DM Exec command.
+    goto :cond_4
 
     new-instance p0, Lcom/idm/fotaagent/database/sqlite/database/mo/MoFumoExtDao;
 
     invoke-virtual {v0}, Lcom/idm/fotaagent/database/sqlite/database/dao/ActionInfoDao;->getServerId()Ljava/lang/String;
