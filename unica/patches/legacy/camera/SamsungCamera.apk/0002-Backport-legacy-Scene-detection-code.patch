From 917579d38efc5e745106e5ccd0de689b7f9a2624 Mon Sep 17 00:00:00 2001
From: HackMeGG <58815983+HackMeGG@users.noreply.github.com>
Date: Sat, 19 Sep 2026 11:36:01 +0200
Subject: [PATCH] Backport legacy Scene detection code

Adapted for the S947B Android 17 camera callback and metadata layout.
Legacy camera HALs may omit text-detection metadata while publishing the
scene-detection array or scene-detection node events.

---
diff --git a/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali b/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
--- a/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
+++ b/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
@@ -16,6 +16,9 @@
     }
 .end annotation
 
+
+# static fields
+.field public static volatile sceneDetectionEvent:I = -0x1
 
 # instance fields
 .field public e:Ljava/lang/Integer;
@@ -45,17 +48,52 @@
 .end method
 
 .method public final n1(Lcom/samsung/android/camera/core2/CamDevice;Ljava/lang/Long;Landroid/hardware/camera2/CaptureResult;)V
-    .locals 1
+    .locals 2
 
     if-eqz p1, :cond_0
 
-    sget-object v0, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->e1:Landroid/hardware/camera2/CaptureResult$Key;
+    sget-object v0, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->O0:Landroid/hardware/camera2/CaptureResult$Key;
 
     invoke-static {p3, v0}, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->a(Landroid/hardware/camera2/CaptureResult;Landroid/hardware/camera2/CaptureResult$Key;)Ljava/lang/Object;
 
     move-result-object p3
 
-    check-cast p3, Ljava/lang/Integer;
+    check-cast p3, [J
+
+    if-eqz p3, :cond_1
+
+    const/4 v0, 0x1
+
+    aget-wide v0, p3, v0
+
+    long-to-int p3, v0
+
+    goto :goto_0
+
+    :cond_1
+    sget p3, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->sceneDetectionEvent:I
+
+    :goto_0
+    const/4 v0, 0x2
+
+    if-eq p3, v0, :cond_2
+
+    const/16 v0, 0x27
+
+    if-ne p3, v0, :cond_3
+
+    :cond_2
+    const/4 p3, 0x1
+
+    goto :goto_1
+
+    :cond_3
+    const/4 p3, 0x0
+
+    :goto_1
+    invoke-static {p3}, Ljava/lang/Integer;->valueOf(I)Ljava/lang/Integer;
+
+    move-result-object p3
 
     iget-object v0, p0, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->e:Ljava/lang/Integer;
 
diff --git a/smali_classes2/com/samsung/android/camera/core2/maker/AutoBeautyPhotoMaker.smali b/smali_classes2/com/samsung/android/camera/core2/maker/AutoBeautyPhotoMaker.smali
