+++ b/smali_classes2/com/samsung/android/camera/core2/maker/AutoBeautyPhotoMaker.smali
@@ -1207,6 +1207,8 @@
 
 .method private synthetic lambda$new$5(I[J)V
     .locals 3
+
+    sput p1, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->sceneDetectionEvent:I
 
     iget-object v0, p0, Lcom/samsung/android/camera/core2/maker/MakerBase;->mMakerCallbackManager:Lcom/samsung/android/camera/core2/maker/MakerCallbackManager;
 
diff --git a/smali_classes2/com/samsung/android/camera/core2/maker/BeautyPhotoMaker.smali b/smali_classes2/com/samsung/android/camera/core2/maker/BeautyPhotoMaker.smali
